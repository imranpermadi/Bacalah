{
  "expo": {
    "name": "BACALAH",
    "slug": "bacalah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.bacalah.app"
    },
    "android": {
      "package": "id.bacalah.app",
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD93D"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Bacalah memakai mikrofon agar Cici bisa mendengar suaramu."
        }
      ],
      "expo-asset",
      "./plugins/with-slim-build"
    ],
    "extra": {
      "eas": {
        "projectId": "f24c64b0-dfac-4a01-9390-63113d7fdd08"
      }
    }
  }
}
