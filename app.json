{
  "expo": {
    "name": "BACALAH",
    "slug": "bacalah",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.bacalah.app"
    },
    "android": {
      "package": "id.bacalah.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Bacalah memakai mikrofon agar Cici bisa mendengar suaramu."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "f24c64b0-dfac-4a01-9390-63113d7fdd08"
      }
    }
  }
}
